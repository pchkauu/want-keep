{
  "provider": "bybit",
  "contractVersion": "10",
  "actions": [
    "read_accounts",
    "read_balances",
    "read_transactions",
    "read_history"
  ],
  "products": ["current", "wallet"],
  "logs": [
    {
      "product": "current",
      "namespace": "payments",
      "recordKinds": ["account", "balance_snapshot", "transaction"]
    },
    {
      "product": "wallet",
      "namespace": "trades",
      "recordKinds": ["account", "balance_snapshot", "transaction"]
    },
    {
      "product": "wallet",
      "namespace": "mining",
      "recordKinds": ["account", "balance_snapshot", "transaction"]
    }
  ],
  "history": {
    "paginated": true,
    "maximumLookbackDays": 90
  }
}
