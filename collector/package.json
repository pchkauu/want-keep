{
  "name": "@want-keep/collector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "start": "node dist/server-main.js",
    "test": "vitest run --exclude tests/security.browser.test.ts",
    "test:security": "vitest run tests/security.browser.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
